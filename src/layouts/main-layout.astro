---
import '@fontsource-variable/raleway';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import { SEO } from 'astro-seo';

import Footer from "../components/footer.astro";
import NavBar from "../components/nav-bar.astro";
import Hero from '../components/hero.astro';

const { lang, description } = Astro.props;
const host: string = import.meta.env.HOST;
const keywords: string = `
'cristian tejeda',
'cristian alberto tejeda rojas',
'Javascript Developer',
'developer',
'web developer',
'web developer portfolio',
'web developer page'
`;

---
<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} data-rh="true"/>
    <meta name="keywords" content={keywords}>
    <meta name="theme-color" content="#ffffff">
    <title>Cristian Tejeda</title>
    <!-- facebook meta tags -->
    <meta property="og:url" content=`https://www.tcriss.com/${lang === 'en' ? 'en' : 'es'}` />
    <meta property="og:type" content="website" />
    <meta property="og:title" content=`Cristian Tejeda - ${lang === 'en' ? "Web Developer" : 'Desarrollador Web'}`/>
    <meta property="og:description" content={description} />
    <meta property="og:image" itemprop="image" content={`${host}/images/${lang === 'en' ? 'preview_en.png' : 'preview_es.png'}`} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <!-- twiiter meta tags -->
    <meta property="twitter:card" content={`${host}/images/${lang === 'en' ? 'preview_en.png' : 'preview_es.png'}`} />
	<meta property="twitter:url" content=`https://www.tcriss.com/${lang === 'en' ? 'en' : 'es'}` />
	<meta property="twitter:title" content=`Cristian Tejeda - ${lang === 'en' ? "Web Developer" : 'Desarrollador Web'}`/>
	<meta property="twitter:description" content={description} />
	<meta property="twitter:image" content={`${host}/images/${lang === 'en' ? 'preview_en.png' : 'preview_es.png'}`} />

    <link rel="apple-touch-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href=`${host}/favicon.svg` />
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.5.1/uicons-regular-rounded/css/uicons-regular-rounded.css'>
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.5.1/uicons-bold-straight/css/uicons-bold-straight.css'>
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.5.1/uicons-brands/css/uicons-brands.css'>
    <link rel='stylesheet' href='https://cdn-uicons.flaticon.com/2.5.1/uicons-solid-rounded/css/uicons-solid-rounded.css'>
</head>
<body transition:animate="slide" class="flex font-inter flex-col dark:bg-[#151515] dark:text-white items-center">
    <NavBar lang={lang}/>
    <Hero id="home" lang={lang}/>
    <main class="w-10/12 md:w-4/6 grid gap-12">
        <slot/>
        <Footer lang={lang}/>
    </main>
</body>
</html>
<style is:global>
    html {
        scroll-behavior: smooth;
    }

    @media (prefers-reduced-motion: no-preference) {
            @supports (animation-timeline: scroll()) {
                p, h3 {
                    animation: reveal-text linear forwards;
                    animation-timeline: view();
                    animation-range: cover 0% entry-crossing 100%;
                }
            }
        }
        @keyframes reveal-text {
            0% {
                opacity: 0;
            }
            100% {
                opacity: 1;
            }
    }
</style>